# VoiceIQMatter settings
# Change only the values on these four lines.

set(VOICEIQ_MATTER_TRANSPORT "wifi")     # "wifi" or "thread"
set(VOICEIQ_ENABLE_HTTP_DEBUG ON)        # ON or OFF; always off on Thread
set(VOICEIQ_HOSTNAME "voiceiqmatter")   # .local is added automatically
set(VOICEIQ_MATTER_PASSCODE 20202021)    # Eight-digit Matter pairing code
